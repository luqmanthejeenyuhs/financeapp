# --- Database ---
# Dev default: local SQLite file, zero setup. Swap for Postgres in prod:
# DATABASE_URL="postgresql://user:password@host:5432/alphatraders"
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- OANDA ---
# From your OANDA account: Manage API Access → Generate Token.
# One token is used for all client accounts (each client's own account id
# is stored per-user in the database, via /dashboard/settings).
OANDA_API_TOKEN="your-oanda-personal-access-token"

# --- Payments (not yet wired to a real processor) ---
# See lib/payments/provider.ts — deposits/withdrawals only create PENDING
# database records until you integrate a licensed payment processor.

# --- Autonomous compliance sweep ---
# Protects POST /api/cron/soft-ban-incomplete-kyc — see that file for what
# it does and how to schedule it. Generate one the same way as
# NEXTAUTH_SECRET.
CRON_SECRET="replace-with-a-long-random-string"
